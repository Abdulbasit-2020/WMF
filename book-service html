<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="Request professional writing, creative, digital media, website development, maintenance and programming services from Wise Media Freelance.">

    <meta name="theme-color" content="#0B1020">

    <title>Book a Service | Wise Media Freelance</title>

    <link rel="stylesheet" href="asset/css/styles.css">

    <style>
        .booking-wrapper {
            max-width: 900px;
            margin: 0 auto;
        }

        .booking-card {
            background: #FFFFFF;
            padding: 40px;
            border-radius: 12px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        }

        .booking-card h2 {
            font-family: var(--heading-font);
            color: var(--navy);
            margin-bottom: 25px;
        }

        .booking-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .booking-full {
            grid-column: 1 / -1;
        }

        .booking-note {
            background: #F9F6EF;
            border-left: 4px solid var(--gold);
            padding: 18px;
            margin-bottom: 25px;
            border-radius: 5px;
            color: #555;
            font-size: 0.9rem;
        }

        .required-label::after {
            content: " *";
            color: #C0392B;
        }

        .booking-card .form-control {
            margin-top: 5px;
        }

        .file-note {
            font-size: 0.82rem;
            color: var(--muted);
            margin-top: 7px;
        }

        .booking-status {
            margin-top: 20px;
            padding: 15px;
            background: #F3F4F6;
            border-radius: 6px;
            font-size: 0.9rem;
            color: #555;
        }

        .conditional-section {
            display: none;
        }

        .conditional-section.active {
            display: block;
        }

        .section-description {
            color: var(--muted);
            font-size: 0.9rem;
            margin-top: -15px;
            margin-bottom: 20px;
        }

        .booking-card select:disabled,
        .booking-card input:disabled {
            background: #F3F4F6;
            cursor: not-allowed;
        }

        @media (max-width: 650px) {
            .booking-card {
                padding: 22px;
            }

            .booking-grid {
                grid-template-columns: 1fr;
            }

            .booking-full {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>

<!-- HEADER -->

<header class="site-header">

    <div class="container header-inner">

        <a href="index.html" class="brand">
            <span class="brand-name">WMF</span>
            <span class="brand-subtitle">WISE MEDIA FREELANCE</span>
        </a>

        <button
            class="menu-toggle"
            id="menuToggle"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mainNav">
            ☰
        </button>

        <nav class="main-nav" id="mainNav">
            <a href="index.html">Home</a>
            <a href="about.html">About</a>
            <a href="services.html">Services</a>
            <a href="contact.html">Contact</a>
            <a href="track-order.html">Track Order</a>
        </nav>

        <div class="header-actions">
            <a href="login.html" class="login-link">Login</a>

            <a href="book-service.html" class="btn btn-primary">
                Get Started
            </a>
        </div>

    </div>

</header>


<main>

    <!-- PAGE BANNER -->

    <section class="page-banner">

        <div class="container">

            <span class="hero-label">Work With Us</span>

            <h1>Book a Service</h1>

            <p>
                Tell us about your project and
                the professional support you need.
            </p>

        </div>

    </section>


    <!-- BOOKING FORM -->

    <section class="section section-light">

        <div class="container">

            <div class="section-heading">

                <span class="hero-label">Start Your Project</span>

                <h2>Let's Understand Your Requirements</h2>

                <p>
                    Complete the booking request form below
                    with accurate information about your project.
                </p>

            </div>


            <div class="booking-wrapper">

                <div class="booking-card">

                    <div class="booking-note">

                        <strong>Before you begin:</strong>

                        Please provide as much information
                        as possible so we can understand
                        your requirements and review
                        your request appropriately.

                    </div>


                    <form id="bookingForm">

                        <!-- 01. CLIENT INFORMATION -->

                        <h2>01. Your Information</h2>

                        <div class="booking-grid">

                            <div class="form-group">

                                <label for="fullName" class="required-label">
                                    Full Name
                                </label>

                                <input
                                    type="text"
                                    id="fullName"
                                    name="fullName"
                                    class="form-control"
                                    placeholder="Enter your full name"
                                    autocomplete="name"
                                    required>

                            </div>


                            <div class="form-group">

                                <label for="email" class="required-label">
                                    Email Address
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="Enter your email"
                                    autocomplete="email"
                                    required>

                            </div>


                            <div class="form-group">

                                <label for="phone">
                                    Phone Number
                                </label>

                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    class="form-control"
                                    placeholder="Include country code"
                                    autocomplete="tel">

                            </div>


                            <div class="form-group">

                                <label for="country">
                                    Country
                                </label>

                                <input
                                    type="text"
                                    id="country"
                                    name="country"
                                    class="form-control"
                                    placeholder="Your country"
                                    autocomplete="country-name">

                            </div>

                        </div>


                        <!-- 02. PROJECT INFORMATION -->

                        <h2 style="margin-top: 35px;">
                            02. Project Information
                        </h2>

                        <div class="booking-grid">

                            <div class="form-group booking-full">

                                <label for="projectTitle" class="required-label">
                                    Project Title
                                </label>

                                <input
                                    type="text"
                                    id="projectTitle"
                                    name="projectTitle"
                                    class="form-control"
                                    placeholder="Give your project a title"
                                    required>

                            </div>


                            <!-- SERVICE CATEGORY -->

                            <div class="form-group">

                                <label
                                    for="serviceCategory"
                                    class="required-label">

                                    Service Category

                                </label>

                                <select
                                    id="serviceCategory"
                                    name="serviceCategory"
                                    class="form-control"
                                    required>

                                    <option value="">
                                        Select a category
                                    </option>

                                    <option value="writing">
                                        Writing Services
                                    </option>

                                    <option value="creative">
                                        Creative Services
                                    </option>

                                    <option value="digital-media">
                                        Digital Media Services
                                    </option>

                                    <option value="website-development">
                                        Website Design & Development
                                    </option>

                                    <option value="website-maintenance">
                                        Website Maintenance & Management
                                    </option>

                                    <option value="programming">
                                        Programming & Software Development
                                    </option>

                                    <option value="other">
                                        Other / Not Sure
                                    </option>

                                </select>

                            </div>


                            <!-- SPECIFIC SERVICE -->

                            <div class="form-group">

                                <label
                                    for="serviceType"
                                    class="required-label">

                                    Specific Service

                                </label>

                                <select
                                    id="serviceType"
                                    name="serviceType"
                                    class="form-control"
                                    required
                                    disabled>

                                    <option value="">
                                        Select a category first
                                    </option>

                                </select>

                            </div>


                            <div class="form-group">

                                <label for="deadline">
                                    Expected Deadline
                                </label>

                                <input
                                    type="date"
                                    id="deadline"
                                    name="deadline"
                                    class="form-control">

                            </div>


                            <div class="form-group">

                                <label for="budget">
                                    Estimated Budget
                                </label>

                                <input
                                    type="text"
                                    id="budget"
                                    name="budget"
                                    class="form-control"
                                    placeholder="e.g. 100 USD, 50,000 NGN">

                            </div>

                        </div>


                        <!-- 03. WEBSITE AND PROGRAMMING DETAILS -->

                        <div
                            id="technicalSection"
                            class="conditional-section">

                            <h2 style="margin-top: 35px;">
                                03. Website & Technical Requirements
                            </h2>

                            <p class="section-description">
                                Please provide additional information
                                about your website or software project.
                            </p>

                            <div class="booking-grid">

                                <div class="form-group">

                                    <label for="projectStage">
                                        Project Type
                                    </label>

                                    <select
                                        id="projectStage"
                                        name="projectStage"
                                        class="form-control">

                                        <option value="">
                                            Select project type
                                        </option>

                                        <option value="new-project">
                                            New Project
                                        </option>

                                        <option value="existing-project">
                                            Existing Website / Application
                                        </option>

                                        <option value="redesign">
                                            Redesign or Improvement
                                        </option>

                                    </select>

                                </div>


                                <div class="form-group">

                                    <label for="websiteType">
                                        Website / Application Type
                                    </label>

                                    <select
                                        id="websiteType"
                                        name="websiteType"
                                        class="form-control">

                                        <option value="">
                                            Select project type
                                        </option>

                                        <option value="business">
                                            Business / Corporate Website
                                        </option>

                                        <option value="portfolio">
                                            Personal / Portfolio Website
                                        </option>

                                        <option value="ecommerce">
                                            E-commerce Website
                                        </option>

                                        <option value="blog">
                                            Blog / News Website
                                        </option>

                                        <option value="landing-page">
                                            Landing Page
                                        </option>

                                        <option value="web-app">
                                            Web Application
                                        </option>

                                        <option value="dashboard">
                                            Admin / Client Dashboard
                                        </option>

                                        <option value="other">
                                            Other
                                        </option>

                                    </select>

                                </div>


                                <div class="form-group booking-full">

                                    <label for="existingWebsite">
                                        Existing Website URL (Optional)
                                    </label>

                                    <input
                                        type="url"
                                        id="existingWebsite"
                                        name="existingWebsite"
                                        class="form-control"
                                        placeholder="https://example.com">

                                </div>


                                <div class="form-group booking-full">

                                    <label for="technologies">
                                        Preferred Technologies (Optional)
                                    </label>

                                    <input
                                        type="text"
                                        id="technologies"
                                        name="technologies"
                                        class="form-control"
                                        placeholder="e.g. HTML, CSS, JavaScript, React, PHP, Python">

                                </div>


                                <div class="form-group booking-full">

                                    <label for="functionality">
                                        Required Features & Functionality
                                    </label>

                                    <textarea
                                        id="functionality"
                                        name="functionality"
                                        class="form-control"
                                        placeholder="Describe any features you want, such as user registration, login, booking systems, dashboards, payment integration, databases or other functionality..."></textarea>

                                </div>

                            </div>

                        </div>


                        <!-- 04. PROJECT DESCRIPTION -->

                        <h2 style="margin-top: 35px;">
                            04. Project Description
                        </h2>

                        <div class="booking-grid">

                            <div class="form-group booking-full">

                                <label
                                    for="projectDescription"
                                    class="required-label">

                                    Describe Your Project

                                </label>

                                <textarea
                                    id="projectDescription"
                                    name="projectDescription"
                                    class="form-control"
                                    placeholder="Describe your project, requirements, goals and expectations..."
                                    required></textarea>

                            </div>

                        </div>


                        <!-- 05. SUPPORTING DOCUMENTS -->

                        <h2 style="margin-top: 35px;">
                            05. Supporting Documents
                        </h2>

                        <div class="form-group">

                            <label for="attachments">
                                Attach Project Files (Optional)
                            </label>

                            <input
                                type="file"
                                id="attachments"
                                name="attachments"
                                class="form-control"
                                accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png"
                                disabled>

                            <p class="file-note">
                                File uploads are not yet available.
                                This feature will be activated after
                                backend integration.
                            </p>

                        </div>


                        <!-- 06. AGREEMENT -->

                        <h2 style="margin-top: 35px;">
                            06. Confirmation
                        </h2>

                        <div class="form-group">

                            <label style="display: flex; gap: 10px; align-items: flex-start;">

                                <input
                                    type="checkbox"
                                    id="agreement"
                                    name="agreement"
                                    required
                                    style="margin-top: 6px;">

                                <span>
                                    I confirm that the information
                                    provided is accurate and may
                                    be used to review my service
                                    request.
                                </span>

                            </label>

                        </div>


                        <!-- SUBMISSION STATUS -->

                        <div
                            class="booking-status"
                            id="bookingStatus"
                            role="status"
                            aria-live="polite">

                            <strong>Checking your client account...</strong>

                            <br><br>

                            Please wait while we verify your account
                            before enabling booking submission.

                        </div>


                        <!-- SUBMIT BUTTON -->

                        <button
                            type="submit"
                            id="bookingSubmitButton"
                            class="btn btn-primary"
                            style="width: 100%; margin-top: 25px;"
                            disabled>

                            Checking Your Account...

                        </button>


                    </form>

                </div>

            </div>

        </div>

    </section>


    <!-- CLIENT ACCOUNT CTA -->

    <section class="cta-section">

        <div class="container">

            <h2>Already Have an Account?</h2>

            <p>
                Sign in to access your client area
                and manage your projects.
            </p>

            <a href="login.html" class="btn btn-primary">
                Client Login
            </a>

        </div>

    </section>

</main>


