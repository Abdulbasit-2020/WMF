<!-- BOOKING FORM CATEGORY LOGIC -->

<script>

    const serviceOptions = {

        writing: [
            ["article-writing", "Article / Blog Writing"],
            ["content-writing", "Content Writing"],
            ["editing", "Editing / Proofreading"],
            ["business-writing", "Business Writing"],
            ["document-preparation", "Document Preparation"],
            ["research-content", "Research-Based Content"]
        ],

        creative: [
            ["creative-content", "Creative Content"],
            ["brand-communication", "Brand Communication"],
            ["presentation", "Presentation Development"],
            ["visual-communication", "Visual Communication"]
        ],

        "digital-media": [
            ["social-media", "Social Media Content"],
            ["digital-content", "Digital Content"],
            ["online-branding", "Online Brand Communication"],
            ["content-planning", "Digital Content Planning"]
        ],

        "website-development": [
            ["business-website", "Business / Corporate Website"],
            ["portfolio-website", "Personal / Portfolio Website"],
            ["ecommerce-website", "E-commerce Website"],
            ["blog-website", "Blog / News Website"],
            ["landing-page", "Landing Page Development"],
            ["website-redesign", "Website Redesign"],
            ["responsive-website", "Responsive Website Development"],
            ["custom-website", "Custom Website Development"]
        ],

        "website-maintenance": [
            ["regular-maintenance", "Regular Website Maintenance"],
            ["content-updates", "Website Content Updates"],
            ["bug-fixing", "Website Bug Fixing"],
            ["speed-optimization", "Website Speed Optimization"],
            ["security-improvements", "Website Security Improvements"],
            ["backup-recovery", "Backup & Recovery Assistance"],
            ["website-migration", "Website Migration"],
            ["domain-hosting", "Domain & Hosting Assistance"],
            ["functionality-improvements", "Website Functionality Improvements"]
        ],

        programming: [
            ["frontend-development", "Frontend Development"],
            ["backend-development", "Backend Development"],
            ["web-application", "Web Application Development"],
            ["database-integration", "Database Integration"],
            ["api-integration", "API Integration"],
            ["automation", "Scripts & Automation"],
            ["dashboard-development", "Admin / Client Dashboard Development"],
            ["authentication-system", "Login & Registration Systems"],
            ["booking-system", "Booking & Management Systems"],
            ["payment-integration", "Payment Gateway Integration"],
            ["custom-programming", "Custom Programming"]
        ],

        other: [
            ["other-service", "Other / Custom Request"]
        ]

    };


    // FORM ELEMENTS

    const categorySelect = document.getElementById("serviceCategory");

    const serviceSelect = document.getElementById("serviceType");

    const technicalSection = document.getElementById("technicalSection");

    const bookingForm = document.getElementById("bookingForm");


    // TECHNICAL INPUTS

    const technicalFields = [
        "projectStage",
        "websiteType",
        "existingWebsite",
        "technologies",
        "functionality"
    ];


    // UPDATE SERVICE OPTIONS

    function updateServiceOptions() {

        const selectedCategory = categorySelect.value;

        // Reset service dropdown.

        serviceSelect.innerHTML = "";

        const placeholder = document.createElement("option");

        placeholder.value = "";

        placeholder.textContent = selectedCategory
            ? "Select a service"
            : "Select a category first";

        serviceSelect.appendChild(placeholder);

        serviceSelect.disabled = !selectedCategory;


        // Load services for selected category.

        const options = serviceOptions[selectedCategory] || [];

        options.forEach(function(service) {

            const option = document.createElement("option");

            option.value = service[0];

            option.textContent = service[1];

            serviceSelect.appendChild(option);

        });


        // Determine whether technical questions are needed.

        const technicalCategories = [
            "website-development",
            "website-maintenance",
            "programming"
        ];

        const needsTechnicalDetails =
            technicalCategories.includes(selectedCategory);


        // Show or hide technical section.

        if (needsTechnicalDetails) {

            technicalSection.classList.add("active");

        } else {

            technicalSection.classList.remove("active");

            // Clear old technical information.

            technicalFields.forEach(function(fieldId) {

                const field = document.getElementById(fieldId);

                if (field) {
                    field.value = "";
                }

            });

        }

    }


    // CATEGORY CHANGE EVENT

    categorySelect.addEventListener(
        "change",
        updateServiceOptions
    );


    // SET MINIMUM DEADLINE TO TODAY

    const deadlineInput = document.getElementById("deadline");

    const today = new Date();

    const localToday = new Date(
        today.getTime() - today.getTimezoneOffset() * 60000
    ).toISOString().split("T")[0];

    deadlineInput.min = localToday;


    // INITIALIZE FORM STATE

    updateServiceOptions();

</script>


